# RepoPilot Environment Configuration Template
# DO NOT place actual secrets in this file. Copy to .env.local for local development.

# Required: Google Gemini API Key for AI synthesis (uses Gemini 2.0 / Flash)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token (classic or fine-grained, read-only: public_repo)
# Increases GitHub API rate limit from 60 req/hr to 5,000 req/hr.
# The app works without a token, but may hit GitHub's unauthenticated IP rate limits.
GITHUB_TOKEN=
